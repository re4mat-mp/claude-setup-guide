{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/workflow-guard.py",
            "timeout": 10,
            "statusMessage": "Checking workflow cost risk..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/gh-guard.sh",
            "timeout": 20,
            "statusMessage": "Checking merges, pushes and review requests..."
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/pkill-guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
